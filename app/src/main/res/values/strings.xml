    <!-- Setup -->
    <string name="setup_title">Set up Screenkeeper</string>
    <string name="setup_intro">Two special permissions are needed to measure app time and to show the block screen. Grant them, then come back here.</string>
    <string name="perm_usage">Usage access</string>
    <string name="perm_usage_desc">Required. Lets Screenkeeper see which app is open and for how long.</string>
    <string name="perm_overlay">Display over other apps</string>
    <string name="perm_overlay_desc">Required. Lets the block screen appear on top of an app.</string>
    <string name="perm_notif">Notifications</string>
    <string name="perm_notif_desc">Optional. Warns you 5 minutes before a limit.</string>
    <string name="perm_battery">Ignore battery optimization</string>
    <string name="perm_battery_desc">Recommended on phones, so limits keep working in the background.</string>
    <string name="adb_button">Settings screen missing? Show ADB commands</string>
    <string name="adb_title">Grant with ADB</string>
    <string name="adb_body">Some TVs hide these settings. Enable Developer options and network debugging on the device, then run these from a computer (after adb connect &lt;device-ip&gt;):</string>

